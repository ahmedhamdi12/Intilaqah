@model IEnumerable<Intilaqah.Models.AuditLog>
@{
    ViewData["Title"] = "سجل الأحداث";
}

<div class="il-page-header">
    <div>
        <h1 class="page-title">سجل الأحداث</h1>
        <div class="page-subtitle">
            إجمالي: @ViewBag.TotalCount سجل
        </div>
    </div>
</div>

<div class="il-card mb-3" style="padding:12px 16px">
    <form method="get" class="d-flex gap-3 align-items-center flex-wrap">
        <select name="entity" class="il-form-control" style="max-width:180px">
            <option value="">كل الكيانات</option>
            <option value="Employee"    selected="@(ViewBag.EntityFilter=="Employee")">
                موظف
            </option>
            <option value="Tenant"      selected="@(ViewBag.EntityFilter=="Tenant")">
                شركة
            </option>
            <option value="PayrollRun"  selected="@(ViewBag.EntityFilter=="PayrollRun")">
                مسير رواتب
            </option>
        </select>
        <select name="logAction" class="il-form-control" style="max-width:150px">
            <option value="">كل الإجراءات</option>
            <option value="Create" selected="@(ViewBag.ActionFilter=="Create")">
                إنشاء
            </option>
            <option value="Update" selected="@(ViewBag.ActionFilter=="Update")">
                تعديل
            </option>
            <option value="Delete" selected="@(ViewBag.ActionFilter=="Delete")">
                حذف
            </option>
        </select>
        <button type="submit" class="btn-il btn-il-outline btn-il-sm">
            <i class="ti ti-filter"></i> فلترة
        </button>
    </form>
</div>

<div class="il-card">
    <div class="table-wrap">
        <table class="il-table">
            <thead>
                <tr>
                    <th>الإجراء</th>
                    <th>الكيان</th>
                    <th>المستخدم</th>
                    <th>التاريخ</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    var actionClass = log.Action switch
                    {
                        "Create" => "active",
                        "Update" => "info",
                        "Delete" => "danger",
                        _ => "inactive"
                    };
                    var actionLabel = log.Action switch
                    {
                        "Create" => "إنشاء",
                        "Update" => "تعديل",
                        "Delete" => "حذف",
                        _ => log.Action
                    };
                    <tr>
                        <td>
                            <span class="il-badge @actionClass">
                                @actionLabel
                            </span>
                        </td>
                        <td>
                            <strong>@log.EntityName</strong>
                            @if (!string.IsNullOrEmpty(log.EntityId))
                            {
                                <div style="font-size:11px;
                                            color:var(--il-muted);
                                            font-family:monospace">
                                    @log.EntityId.Substring(0, 8)...
                                </div>
                            }
                        </td>
                        <td>@(log.UserName ?? "—")</td>
                        <td>
                            @log.CreatedAt.ToString("dd/MM/yyyy")
                            <div style="font-size:11px;color:var(--il-muted)">
                                @log.CreatedAt.ToString("hh:mm tt")
                            </div>
                        </td>
                        <td style="font-size:12px;color:var(--il-muted);
                                   font-family:monospace">
                            @(log.IpAddress ?? "—")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Pagination *@
    @if ((int)ViewBag.TotalPages > 1)
    {
        <div style="display:flex;justify-content:center;
                    gap:8px;padding:16px;flex-wrap:wrap">
            @for (int p = 1; p <= (int)ViewBag.TotalPages; p++)
            {
                <a href="?page=@p&entity=@ViewBag.EntityFilter&logAction=@ViewBag.ActionFilter"
                   class="btn-il @(p == (int)ViewBag.CurrentPage
                       ? "btn-il-primary" : "btn-il-outline") btn-il-sm">
                    @p
                </a>
            }
        </div>
    }
</div>
