@model IEnumerable<Intilaqah.Models.ViewModels.SuperAdmin.IntegrationLogListVM>
@{
    ViewData["Title"] = "سجلات الربط الخارجي";
}

<div class="il-page-header">
    <div>
        <h1 class="page-title">سجلات الربط الخارجي</h1>
        <div class="page-subtitle">
            مراقبة كل الاتصالات مع قوى ومدد
        </div>
    </div>
</div>

@* KPI Cards *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
        <div class="il-kpi">
            <div class="kpi-top">
                <div class="kpi-icon green">
                    <i class="ti ti-circle-check"></i>
                </div>
            </div>
            <div class="kpi-value text-success-il">@ViewBag.SuccessCount</div>
            <div class="kpi-label">ناجح</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="il-kpi">
            <div class="kpi-top">
                <div class="kpi-icon red">
                    <i class="ti ti-circle-x"></i>
                </div>
            </div>
            <div class="kpi-value text-danger-il">@ViewBag.FailedCount</div>
            <div class="kpi-label">فشل</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="il-kpi">
            <div class="kpi-top">
                <div class="kpi-icon amber">
                    <i class="ti ti-clock"></i>
                </div>
            </div>
            <div class="kpi-value">@ViewBag.PendingCount</div>
            <div class="kpi-label">قيد المعالجة</div>
        </div>
    </div>
</div>

@* Filter *@
<div class="il-card mb-3" style="padding:12px 16px">
    <form method="get" class="d-flex gap-3 align-items-center flex-wrap">
        <select name="provider" class="il-form-control" style="max-width:160px">
            <option value="">كل المنصات</option>
            <option value="Qiwa"  selected="@(ViewBag.ProviderFilter=="Qiwa")">
                قوى
            </option>
            <option value="Mudad" selected="@(ViewBag.ProviderFilter=="Mudad")">
                مدد
            </option>
        </select>
        <select name="status" class="il-form-control" style="max-width:160px">
            <option value="">كل الحالات</option>
            <option value="Success"  selected="@(ViewBag.StatusFilter=="Success")">
                ناجح
            </option>
            <option value="Failed"   selected="@(ViewBag.StatusFilter=="Failed")">
                فشل
            </option>
            <option value="Retrying" selected="@(ViewBag.StatusFilter=="Retrying")">
                إعادة محاولة
            </option>
        </select>
        <button type="submit" class="btn-il btn-il-outline btn-il-sm">
            <i class="ti ti-filter"></i> فلترة
        </button>
    </form>
</div>

@* Logs Table *@
<div class="il-card">
    @if (!Model.Any())
    {
        <div class="text-center py-5" style="color:var(--il-muted)">
            <i class="ti ti-plug-connected-x"
               style="font-size:48px;opacity:.25"></i>
            <div class="mt-3" style="font-size:14px">
                لا توجد سجلات بعد
            </div>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="il-table">
                <thead>
                    <tr>
                        <th>المنصة</th>
                        <th>الشركة</th>
                        <th>العملية</th>
                        <th>الحالة</th>
                        <th>HTTP</th>
                        <th>المدة</th>
                        <th>إعادة المحاولة</th>
                        <th>التاريخ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        var (providerLabel, providerColor) =
                            log.Provider == Intilaqah.Models.Integration
                                .IntegrationProvider.Qiwa
                            ? ("قوى", "#1d4ed8")
                            : ("مدد", "#0d9e6e");

                        var (statusLabel, statusClass) = log.Status switch
                        {
                            Intilaqah.Models.Integration
                                .IntegrationStatus.Success  =>
                                ("ناجح", "active"),
                            Intilaqah.Models.Integration
                                .IntegrationStatus.Failed   =>
                                ("فشل", "danger"),
                            Intilaqah.Models.Integration
                                .IntegrationStatus.Retrying =>
                                ("إعادة", "warning"),
                            Intilaqah.Models.Integration
                                .IntegrationStatus.Pending  =>
                                ("معلّق", "info"),
                            _ => ("—", "inactive")
                        };

                        <tr>
                            <td>
                                <span class="il-badge info"
                                      style="background:@providerColor + '18';
                                             color:@providerColor">
                                    @providerLabel
                                </span>
                            </td>
                            <td>@log.TenantName</td>
                            <td style="font-family:monospace;font-size:12px">
                                @log.Operation
                            </td>
                            <td>
                                <span class="il-badge @statusClass">
                                    @statusLabel
                                </span>
                                @if (!string.IsNullOrEmpty(log.ErrorMessage))
                                {
                                    <div style="font-size:11px;
                                                color:var(--il-danger);
                                                margin-top:2px"
                                         title="@log.ErrorMessage">
                                        @(log.ErrorMessage.Length > 40
                                            ? log.ErrorMessage[..40] + "..."
                                            : log.ErrorMessage)
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="il-badge @(log.HttpStatus >= 200
                                    && log.HttpStatus < 300 ? "active" : "danger")"
                                      style="font-family:monospace">
                                    @(log.HttpStatus > 0
                                        ? log.HttpStatus.ToString()
                                        : "—")
                                </span>
                            </td>
                            <td style="font-size:12px;color:var(--il-muted)">
                                @log.DurationMs ms
                            </td>
                            <td>
                                @if (log.RetryCount > 0)
                                {
                                    <span class="il-badge warning">
                                        #@log.RetryCount
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--il-muted)">—</span>
                                }
                            </td>
                            <td style="font-size:13px" dir="ltr">
                                @log.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
