@model IEnumerable<Intilaqah.Models.Notification>
@{
    ViewData["Title"] = "الإشعارات";
}

<div class="il-page-header">
    <div>
        <h1 class="page-title">الإشعارات</h1>
        <div class="page-subtitle">
            @ViewBag.UnreadCount غير مقروء
        </div>
    </div>
    <div class="page-actions">
        @if ((int)(ViewBag.UnreadCount ?? 0) > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-il btn-il-outline">
                    <i class="ti ti-checks"></i> تحديد الكل كمقروء
                </button>
            </form>
        }
    </div>
</div>

<div class="il-card">
    @if (!Model.Any())
    {
        <div class="text-center py-5" style="color:var(--il-muted)">
            <i class="ti ti-bell-off" style="font-size:48px;opacity:.25"></i>
            <div class="mt-3" style="font-size:14px">
                لا توجد إشعارات
            </div>
        </div>
    }
    else
    {
        <div style="display:flex;flex-direction:column">
            @foreach (var n in Model)
            {
                var typeIcon = n.Type switch
                {
                    Intilaqah.Models.NotificationType.DocumentExpiry =>
                        "ti-file-alert",
                    Intilaqah.Models.NotificationType.PayrollReady   =>
                        "ti-receipt",
                    Intilaqah.Models.NotificationType.LeaveRequest   =>
                        "ti-calendar",
                    Intilaqah.Models.NotificationType.ViolationAdded =>
                        "ti-alert-triangle",
                    Intilaqah.Models.NotificationType.ContractExpiry =>
                        "ti-file-text",
                    _ => "ti-bell"
                };
                var typeColor = n.Type switch
                {
                    Intilaqah.Models.NotificationType.DocumentExpiry =>
                        "var(--il-danger)",
                    Intilaqah.Models.NotificationType.PayrollReady   =>
                        "var(--il-success)",
                    Intilaqah.Models.NotificationType.LeaveRequest   =>
                        "var(--il-info)",
                    _ => "var(--il-warning)"
                };
                <div class="notif-item @(n.IsRead ? "" : "unread")"
                     style="display:flex;align-items:flex-start;gap:12px;
                            padding:14px 16px;
                            border-bottom:1px solid var(--il-border);
                            background:@(n.IsRead ? "transparent" : "#fffbeb")">

                    <div style="width:36px;height:36px;border-radius:9px;
                                background:@typeColor + '18';
                                display:flex;align-items:center;
                                justify-content:center;flex-shrink:0">
                        <i class="ti @typeIcon"
                           style="font-size:18px;color:@typeColor"></i>
                    </div>

                    <div style="flex:1">
                        <div style="font-size:13.5px;font-weight:@(n.IsRead ? "400" : "600");
                                    color:var(--il-text)">
                            @n.Title
                        </div>
                        <div style="font-size:12.5px;color:var(--il-muted);
                                    margin-top:2px">
                            @n.Message
                        </div>
                        <div style="font-size:11px;color:var(--il-muted);
                                    margin-top:4px">
                            @n.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")
                        </div>
                    </div>

                    <div style="display:flex;align-items:center;gap:8px;
                                flex-shrink:0">
                        @if (!string.IsNullOrEmpty(n.ActionUrl))
                        {
                            <a href="@n.ActionUrl"
                               class="btn-il btn-il-outline btn-il-sm">
                                عرض
                            </a>
                        }
                        @if (!n.IsRead)
                        {
                            <span class="il-badge warning"
                                  style="font-size:10px">جديد</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
