@model IEnumerable<Intilaqah.Models.ViewModels.Employee.PayslipListItemVM>
@{
    ViewData["Title"] = "مسيراتي";
}

<div class="il-page-header">
    <div><h1 class="page-title">مسيرات الرواتب</h1></div>
</div>

<div class="il-card">
    @if (!Model.Any())
    {
        <div class="text-center py-5" style="color:var(--il-muted)">
            <i class="ti ti-receipt"
               style="font-size:48px;opacity:.25"></i>
            <div class="mt-3" style="font-size:14px">
                لا توجد مسيرات رواتب بعد
            </div>
        </div>
    }
    else
    {
        <table class="il-table">
            <thead>
                <tr>
                    <th>الشهر</th>
                    <th>الإجمالي</th>
                    <th>الاستقطاعات</th>
                    <th>الصافي</th>
                    <th>الحضور</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slip in Model)
                {
                    <tr>
                        <td><strong>@slip.MonthName</strong></td>
                        <td>@slip.GrossSalary.ToString("N0") ر.س</td>
                        <td style="color:var(--il-danger)">
                            @(slip.TotalDeductions > 0
                                ? $"-{slip.TotalDeductions:N0} ر.س"
                                : "—")
                        </td>
                        <td>
                            <strong style="color:var(--il-success)">
                                @slip.NetSalary.ToString("N0") ر.س
                            </strong>
                        </td>
                        <td style="font-size:12px;color:var(--il-muted)">
                            حضور: @slip.PresentDays |
                            غياب: @slip.AbsentDays
                        </td>
                        <td>
                            <a href="/Employee/Payslips/Details/@slip.PayrollRunId"
                               class="btn-il btn-il-outline btn-il-sm">
                                <i class="ti ti-eye"></i> تفاصيل
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
