@model IEnumerable<Intilaqah.Models.LeaveRequest>
@{
    ViewData["Title"] = "طلبات الإجازة";
}

<div class="il-page-header">
    <div>
        <h1 class="page-title">طلبات الإجازة</h1>
    </div>
    <div class="page-actions">
        <a href="/Employee/Leaves/Create" class="btn-il btn-il-primary">
            <i class="ti ti-calendar-plus"></i> طلب إجازة جديدة
        </a>
    </div>
</div>

<div class="il-card">
    @if (!Model.Any())
    {
        <div class="text-center py-5" style="color:var(--il-muted)">
            <i class="ti ti-calendar-off"
               style="font-size:48px;opacity:.25"></i>
            <div class="mt-3" style="font-size:14px">
                لا توجد طلبات إجازة بعد
            </div>
            <a href="/Employee/Leaves/Create"
               class="btn-il btn-il-primary mt-3 d-inline-flex">
                <i class="ti ti-calendar-plus"></i> تقديم أول طلب
            </a>
        </div>
    }
    else
    {
        <table class="il-table">
            <thead>
                <tr>
                    <th>نوع الإجازة</th>
                    <th>من</th>
                    <th>إلى</th>
                    <th>الأيام</th>
                    <th>السبب</th>
                    <th>الحالة</th>
                    <th>ملاحظة المراجع</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var req in Model)
                {
                    var typeLabel = req.LeaveType switch {
                        Intilaqah.Models.LeaveType.Annual    => "سنوية",
                        Intilaqah.Models.LeaveType.Sick      => "مرضية",
                        Intilaqah.Models.LeaveType.Emergency => "طارئة",
                        Intilaqah.Models.LeaveType.Unpaid    => "بدون راتب",
                        Intilaqah.Models.LeaveType.Maternity => "أمومة",
                        Intilaqah.Models.LeaveType.Hajj      => "حج",
                        _ => req.LeaveType.ToString()
                    };
                    var (statusLabel, statusClass) = req.Status switch {
                        Intilaqah.Models.LeaveRequestStatus.Pending   =>
                            ("قيد المراجعة", "warning"),
                        Intilaqah.Models.LeaveRequestStatus.Approved  =>
                            ("موافق عليها", "active"),
                        Intilaqah.Models.LeaveRequestStatus.Rejected  =>
                            ("مرفوضة", "danger"),
                        Intilaqah.Models.LeaveRequestStatus.Cancelled =>
                            ("ملغاة", "inactive"),
                        _ => ("—", "inactive")
                    };
                    <tr>
                        <td><strong>@typeLabel</strong></td>
                        <td>@req.StartDate.ToString("dd/MM/yyyy")</td>
                        <td>@req.EndDate.ToString("dd/MM/yyyy")</td>
                        <td>@req.DurationDays يوم</td>
                        <td style="font-size:12px;color:var(--il-muted)">
                            @(req.Reason ?? "—")
                        </td>
                        <td>
                            <span class="il-badge @statusClass">
                                @statusLabel
                            </span>
                        </td>
                        <td style="font-size:12px;color:var(--il-muted)">
                            @(req.ReviewerNotes ?? "—")
                        </td>
                        <td>
                            @if (req.Status == Intilaqah.Models
                                .LeaveRequestStatus.Pending)
                            {
                                <form asp-action="Cancel"
                                      asp-route-id="@req.Id"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn-il btn-il-outline btn-il-sm text-danger"
                                            data-confirm="هل تريد إلغاء هذا الطلب؟">
                                        إلغاء
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
