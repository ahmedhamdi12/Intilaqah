@model Intilaqah.Models.ViewModels.Employee.ProfileEditViewModel
@{
    ViewData["Title"] = "تعديل الملف الشخصي";
}

<div class="il-page-header">
    <div><h1 class="page-title">تعديل الملف الشخصي</h1></div>
    <div class="page-actions">
        <a href="/Employee/Profile" class="btn-il btn-il-outline">
            <i class="ti ti-arrow-right"></i> رجوع
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="il-card">
            <div style="background:var(--il-bg);border-radius:9px;
                        padding:12px 16px;margin-bottom:20px;
                        font-size:13px;color:var(--il-info)">
                <i class="ti ti-info-circle" style="margin-left:5px"></i>
                يمكنك تعديل رقم الجوال والصورة الشخصية فقط. البيانات الأخرى
                تُعدَّل من قِبل مدير الشركة.
            </div>

            <form asp-action="Edit" method="post"
                  enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                @* Read-only info *@
                <div class="mb-3">
                    <label class="il-form-label">الاسم</label>
                    <input type="text" class="il-form-control"
                           value="@Model.FullNameAr" disabled />
                </div>
                <div class="mb-3">
                    <label class="il-form-label">المسمى الوظيفي</label>
                    <input type="text" class="il-form-control"
                           value="@Model.JobTitle" disabled />
                </div>

                <hr style="border-color:var(--il-border)" />

                @* Editable: Phone *@
                <div class="mb-3">
                    <label asp-for="Phone" class="il-form-label">
                        رقم الجوال <span style="color:var(--il-danger)">*</span>
                    </label>
                    <input asp-for="Phone" type="tel"
                           class="il-form-control"
                           placeholder="05xxxxxxxx"
                           dir="ltr" />
                    <span asp-validation-for="Phone"
                          class="text-danger" style="font-size:12px"></span>
                </div>

                @* Editable: Profile Picture *@
                <div class="mb-4">
                    <label asp-for="ProfilePicture" class="il-form-label">
                        الصورة الشخصية
                    </label>

                    @if (!string.IsNullOrEmpty(Model.CurrentProfilePicturePath))
                    {
                        <div class="mb-2">
                            <img id="img-preview"
                                 src="/Employee/Profile/Avatar?fileName=@Model.CurrentProfilePicturePath"
                                 alt="الصورة الحالية"
                                 class="rounded-circle"
                                 style="width:80px;height:80px;object-fit:cover;
                                        border:2px solid var(--il-border)" />
                        </div>
                    }
                    else
                    {
                        <div id="img-preview-placeholder"
                             class="rounded-circle mb-2 d-flex align-items-center justify-content-center"
                             style="width:80px;height:80px;background:var(--il-bg);
                                    border:2px dashed var(--il-border)">
                            <i class="ti ti-user"
                               style="font-size:30px;color:var(--il-muted)"></i>
                        </div>
                    }

                    <input asp-for="ProfilePicture" type="file"
                           class="il-form-control"
                           accept=".jpg,.jpeg,.png,.webp"
                           onchange="previewImg(this)" />
                    <div style="font-size:12px;color:var(--il-muted);margin-top:4px">
                        JPG / PNG / WEBP — الحد الأقصى 3 MB
                    </div>
                    <span asp-validation-for="ProfilePicture"
                          class="text-danger" style="font-size:12px"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a href="/Employee/Profile"
                       class="btn-il btn-il-outline">إلغاء</a>
                    <button type="submit" class="btn-il btn-il-primary">
                        <i class="ti ti-device-floppy"></i> حفظ التغييرات
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
function previewImg(input) {
    if (!input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = e => {
        let img = document.getElementById('img-preview');
        if (!img) {
            img = document.createElement('img');
            img.id = 'img-preview';
            img.className = 'rounded-circle mb-2';
            img.style.cssText =
                'width:80px;height:80px;object-fit:cover;' +
                'border:2px solid var(--il-border)';
            const ph = document.getElementById('img-preview-placeholder');
            if (ph) ph.replaceWith(img);
            else input.parentElement.prepend(img);
        }
        img.src = e.target.result;
    };
    reader.readAsDataURL(input.files[0]);
}
</script>
}
