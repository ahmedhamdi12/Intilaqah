@model IEnumerable<Intilaqah.Models.ViolationRecord>
@{
    ViewData["Title"] = "المخالفات والجزاءات";
    var employees = ViewBag.Employees as Dictionary<Guid, string>;
    var rules = ViewBag.Rules as Dictionary<Guid, string>;
}

<div class="il-page-header">
    <div>
        <h1 class="page-title">المخالفات والجزاءات</h1>
        <div class="page-subtitle">تسجيل المخالفات على الموظفين لخصمها من مسير الرواتب القادم</div>
    </div>
    <div class="page-actions">
        <a href="/CompanyAdmin/Violations/Create" class="btn-il btn-il-primary">
            <i class="ti ti-plus"></i> تسجيل مخالفة
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="il-card text-center py-5" style="color:var(--il-muted)">
        <i class="ti ti-alert-triangle" style="font-size:48px;opacity:.25"></i>
        <div class="mt-3" style="font-size:14px">
            لا توجد مخالفات مسجلة
        </div>
        <a href="/CompanyAdmin/Violations/Create" class="btn-il btn-il-primary mt-3 d-inline-flex">
            <i class="ti ti-plus"></i> تسجيل مخالفة
        </a>
    </div>
}
else
{
    <div class="il-card">
        <div class="table-responsive">
            <table class="il-table">
                <thead>
                    <tr>
                        <th>الموظف</th>
                        <th>المخالفة</th>
                        <th>تاريخ المخالفة</th>
                        <th>الحالة</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model)
                    {
                        <tr>
                            <td class="fw-bold">@(employees != null && employees.ContainsKey(record.EmployeeId) ? employees[record.EmployeeId] : "غير معروف")</td>
                            <td>@(rules != null && rules.ContainsKey(record.ViolationRuleId) ? rules[record.ViolationRuleId] : "غير معروف")</td>
                            <td>@record.ViolationDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (record.PayrollRunId == null)
                                {
                                    <span class="badge bg-warning text-dark">غير محتسبة بعد</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">تم الخصم في مسير الرواتب</span>
                                }
                            </td>
                            <td>
                                @if (record.PayrollRunId == null)
                                {
                                    <form method="post" action="/CompanyAdmin/Violations/Delete/@record.Id" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذه المخالفة؟');">
                                        <button type="submit" class="btn-il btn-il-danger btn-sm">
                                            <i class="ti ti-trash"></i> حذف
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn-il btn-il-light btn-sm" disabled title="لا يمكن حذف مخالفة تم احتسابها في مسير الرواتب">
                                        <i class="ti ti-trash"></i> حذف
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
