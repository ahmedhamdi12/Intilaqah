@model IEnumerable<Intilaqah.Models.SalaryAdvance>
@{
    ViewData["Title"] = "السلف والعهد";
    var employees = ViewBag.Employees as Dictionary<Guid, string>;
}

<div class="il-page-header">
    <div>
        <h1 class="page-title">السلف المالية</h1>
        <div class="page-subtitle">إدارة السلف للموظفين وجدولتها للخصم الشهري من مسير الرواتب</div>
    </div>
    <div class="page-actions">
        <a href="/CompanyAdmin/Advances/Create" class="btn-il btn-il-primary">
            <i class="ti ti-plus"></i> إضافة سلفة
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="il-card text-center py-5" style="color:var(--il-muted)">
        <i class="ti ti-cash" style="font-size:48px;opacity:.25"></i>
        <div class="mt-3" style="font-size:14px">
            لا توجد سلف مسجلة
        </div>
        <a href="/CompanyAdmin/Advances/Create" class="btn-il btn-il-primary mt-3 d-inline-flex">
            <i class="ti ti-plus"></i> تسجيل سلفة
        </a>
    </div>
}
else
{
    <div class="il-card">
        <div class="table-responsive">
            <table class="il-table">
                <thead>
                    <tr>
                        <th>الموظف</th>
                        <th>التاريخ</th>
                        <th>الإجمالي</th>
                        <th>القسط الشهري</th>
                        <th>المتبقي</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var advance in Model)
                    {
                        <tr>
                            <td class="fw-bold">@(employees != null && employees.ContainsKey(advance.EmployeeId) ? employees[advance.EmployeeId] : "غير معروف")</td>
                            <td>@advance.RequestDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-primary">@advance.TotalAmount.ToString("N2") ﷼</td>
                            <td>@advance.MonthlyDeduction.ToString("N2") ﷼</td>
                            <td class="fw-bold @(advance.RemainingAmount > 0 ? "text-danger" : "text-success")">
                                @advance.RemainingAmount.ToString("N2") ﷼
                            </td>
                            <td>
                                @if (advance.Status == Intilaqah.Models.AdvanceStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">معلق</span>
                                }
                                else if (advance.Status == Intilaqah.Models.AdvanceStatus.Approved)
                                {
                                    <span class="badge bg-primary">معتمد</span>
                                }
                                else if (advance.Status == Intilaqah.Models.AdvanceStatus.FullyDeducted)
                                {
                                    <span class="badge bg-success">مسدد بالكامل</span>
                                }
                                else if (advance.Status == Intilaqah.Models.AdvanceStatus.Rejected)
                                {
                                    <span class="badge bg-danger">مرفوض</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
