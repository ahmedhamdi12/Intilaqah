@model Intilaqah.Models.ViewModels.CompanyAdmin.PayrollCreateVM
@{
    ViewData["Title"] = "إنشاء مسير رواتب جديد";
}

<div class="il-page-header">
    <div>
        <h1 class="page-title">مسير رواتب جديد</h1>
        <div class="page-subtitle">حساب الرواتب للشهر الحالي بناءً على الحضور والانصراف والمخالفات</div>
    </div>
    <div class="page-actions">
        <a href="/CompanyAdmin/Payroll" class="btn-il btn-il-light">عودة للمسيرات</a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="il-card">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Month" class="form-label"></label>
                        <select asp-for="Month" class="form-select">
                            @for(int i = 1; i <= 12; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                        <span asp-validation-for="Month" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Year" class="form-label"></label>
                        <input asp-for="Year" class="form-control" />
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="WorkingDays" class="form-label"></label>
                    <input asp-for="WorkingDays" class="form-control" />
                    <div class="form-text">عدد أيام العمل الفعلية في الشهر لحساب خصم الغياب بناءً عليها.</div>
                    <span asp-validation-for="WorkingDays" class="text-danger"></span>
                </div>

                <hr />
                <button type="submit" class="btn-il btn-il-primary w-100">
                    <i class="ti ti-calculator"></i> إنشاء وحساب المسير
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
