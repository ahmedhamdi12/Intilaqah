@model IEnumerable<Intilaqah.Models.PayrollRun>
@{
    ViewData["Title"] = "مسير الرواتب";
}

<div class="il-page-header">
    <div>
        <h1 class="page-title">مسير الرواتب</h1>
        <div class="page-subtitle">إنشاء واعتماد الرواتب الشهرية</div>
    </div>
    <div class="page-actions">
        <a href="/CompanyAdmin/Payroll/Create" class="btn-il btn-il-primary">
            <i class="ti ti-plus"></i> مسير جديد
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="il-card text-center py-5" style="color:var(--il-muted)">
        <i class="ti ti-receipt" style="font-size:48px;opacity:.25"></i>
        <div class="mt-3" style="font-size:14px">
            لا توجد مسيرات رواتب بعد
        </div>
        <a href="/CompanyAdmin/Payroll/Create" class="btn-il btn-il-primary mt-3 d-inline-flex">
            <i class="ti ti-plus"></i> إنشاء أول مسير
        </a>
    </div>
}
else
{
    <div class="il-card">
        <div class="table-responsive">
            <table class="il-table">
                <thead>
                    <tr>
                        <th>الشهر</th>
                        <th>أيام العمل</th>
                        <th>إجمالي الرواتب</th>
                        <th>الاستقطاعات</th>
                        <th>الصافي</th>
                        <th>الحالة</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in Model)
                    {
                        <tr>
                            <td>@run.Month / @run.Year</td>
                            <td>@run.WorkingDays</td>
                            <td class="text-success">@run.TotalGross.ToString("N2") ﷼</td>
                            <td class="text-danger">@run.TotalDeductions.ToString("N2") ﷼</td>
                            <td class="fw-bold">@run.TotalNet.ToString("N2") ﷼</td>
                            <td>
                                @if (run.Status == Intilaqah.Models.PayrollStatus.Draft)
                                {
                                    <span class="badge bg-warning text-dark">مسودة</span>
                                }
                                else if (run.Status == Intilaqah.Models.PayrollStatus.Approved)
                                {
                                    <span class="badge bg-success">معتمد</span>
                                }
                                else if (run.Status == Intilaqah.Models.PayrollStatus.Exported)
                                {
                                    <span class="badge bg-info">مصدر WPS</span>
                                }
                            </td>
                            <td>
                                <a href="/CompanyAdmin/Payroll/Details/@run.Id" class="btn-il btn-il-light btn-sm">
                                    <i class="ti ti-eye"></i> التفاصيل
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
