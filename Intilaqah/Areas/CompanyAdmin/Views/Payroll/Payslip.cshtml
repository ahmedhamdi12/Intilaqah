@model IEnumerable<Intilaqah.Models.PaySlip>
@{
    var run = ViewBag.Run as Intilaqah.Models.PayrollRun;
    ViewData["Title"] = $"مسيرات الموظفين - {ViewBag.MonthName} {run?.Year}";
}

<style>
    .payslip-box {
        border: 1px solid var(--il-border);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
        background: #fff;
    }
    .ps-header {
        border-bottom: 2px solid var(--il-primary);
        padding-bottom: 10px;
        margin-bottom: 15px;
    }
</style>

<div class="il-page-header d-print-none">
    <div>
        <h1 class="page-title">كشوف الرواتب التفصيلية</h1>
        <div class="page-subtitle">شهر @ViewBag.MonthName @run?.Year</div>
    </div>
    <div class="page-actions">
        <a href="/CompanyAdmin/Payroll/Details/@run?.Id" class="btn-il btn-il-light">العودة</a>
        <button onclick="window.print()" class="btn-il btn-il-primary"><i class="ti ti-printer"></i> طباعة الكل</button>
    </div>
</div>

@foreach (var slip in Model)
{
    <div class="payslip-box" style="page-break-inside: avoid;">
        <div class="ps-header d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-1 fw-bold">@slip.EmployeeNameAr</h4>
                <div class="text-muted">الرقم الوظيفي: @slip.EmployeeCode | الهوية: @slip.NationalId</div>
            </div>
            <div class="text-end">
                <div class="fw-bold text-primary">مسير شهر @ViewBag.MonthName @run?.Year</div>
                <div class="text-muted" style="font-size:12px">أيام العمل: @run?.WorkingDays</div>
            </div>
        </div>

        <div class="row">
            <div class="col-6">
                <h6 class="fw-bold text-success mb-2"><i class="ti ti-plus"></i> الاستحقاقات</h6>
                <table class="table table-sm table-borderless">
                    <tr><td>الراتب الأساسي</td><td class="text-end">@slip.BasicSalary.ToString("N2")</td></tr>
                    <tr><td>بدل السكن</td><td class="text-end">@slip.HousingAllowance.ToString("N2")</td></tr>
                    <tr><td>بدل النقل</td><td class="text-end">@slip.TransportAllowance.ToString("N2")</td></tr>
                    <tr><td>بدلات أخرى</td><td class="text-end">@slip.OtherAllowances.ToString("N2")</td></tr>
                    <tr><td>بدل الإضافي (@slip.TotalOvertimeMinutes دقيقة)</td><td class="text-end">@slip.OvertimeAmount.ToString("N2")</td></tr>
                    <tr class="fw-bold border-top"><td>إجمالي الاستحقاقات</td><td class="text-end">@slip.GrossSalary.ToString("N2") ﷼</td></tr>
                </table>
            </div>
            <div class="col-6 border-start">
                <h6 class="fw-bold text-danger mb-2"><i class="ti ti-minus"></i> الاستقطاعات</h6>
                <table class="table table-sm table-borderless">
                    <tr><td>خصم الغياب (@slip.AbsentDays يوم)</td><td class="text-end">@slip.AbsenceDeduction.ToString("N2")</td></tr>
                    <tr><td>خصم التأخر (@slip.TotalLateMinutes دقيقة)</td><td class="text-end">@slip.LateDeduction.ToString("N2")</td></tr>
                    <tr><td>خصم المخالفات</td><td class="text-end">@slip.ViolationDeduction.ToString("N2")</td></tr>
                    <tr><td>خصم السلف</td><td class="text-end">@slip.AdvanceDeduction.ToString("N2")</td></tr>
                    <tr><td>&nbsp;</td><td></td></tr>
                    <tr class="fw-bold border-top text-danger"><td>إجمالي الاستقطاعات</td><td class="text-end">@slip.TotalDeductions.ToString("N2") ﷼</td></tr>
                </table>
            </div>
        </div>
        
        <div class="mt-3 p-3 bg-light rounded d-flex justify-content-between align-items-center">
            <div class="fw-bold">صافي الراتب المستحق</div>
            <h3 class="mb-0 text-primary fw-bold">@slip.NetSalary.ToString("N2") ﷼</h3>
        </div>
    </div>
}
