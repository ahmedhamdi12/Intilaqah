@model Intilaqah.Models.ViewModels.SuperAdmin.ResetPasswordVM
@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
    var empId = ViewContext.RouteData.Values["id"]?.ToString();
}

<div class="il-page-header">
    <div>
        <h1 class="page-title">إعادة تعيين كلمة المرور</h1>
        <div class="page-subtitle">للموظف: @Model.UserName</div>
    </div>
    <div class="page-actions">
        <a href="javascript:history.back()" class="btn-il btn-il-outline">
            <i class="ti ti-arrow-right"></i> رجوع
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="il-card">
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="UserName" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:13px"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="il-form-label"></label>
                    <input asp-for="NewPassword" type="password" class="il-form-control" dir="ltr" />
                    <span asp-validation-for="NewPassword" class="text-danger" style="font-size:12px"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="il-form-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="il-form-control" dir="ltr" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:12px"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn-il btn-il-primary">
                        <i class="ti ti-device-floppy"></i> حفظ كلمة المرور
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
