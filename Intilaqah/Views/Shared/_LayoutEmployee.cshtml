@using Intilaqah.Data
@using System.Security.Claims
@inject ApplicationDbContext DbContext
@{
    var userId    = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var employee  = userId != null
        ? DbContext.Employees.FirstOrDefault(e => e.UserId == userId && !e.IsDeleted)
        : null;
    var picPath   = employee?.ProfilePicturePath;
    var firstName = employee?.FullNameAr?.Split(' ').FirstOrDefault() ?? "موظف";

    // Pending leave count for badge
    int pendingLeaves = 0;
    if (employee != null)
    {
        pendingLeaves = DbContext.LeaveRequests
            .Count(l => l.EmployeeId == employee.Id
                     && l.Status == Intilaqah.Models.LeaveRequestStatus.Pending
                     && !l.IsDeleted);
    }
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - بوابة الموظف</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/intilaqah.css" asp-append-version="true" />
    <style>
        :root {
            --il-primary: #0f766e;
            --il-sidebar-bg: #0f3330;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <header class="il-topbar px-3">
        <div class="d-flex align-items-center h-100 w-100">
            <div class="brand-area d-flex align-items-center" style="width: var(--il-sidebar-w);">
                <button id="sidebarToggle" class="btn btn-sm btn-light d-lg-none me-2">
                    <i class="ti ti-menu-2"></i>
                </button>
                <i class="ti ti-chart-pie-3 text-warning me-2 fs-4"></i>
                <h5 class="mb-0 fw-bold text-primary">انطلاقة HRMS</h5>
            </div>

            <div class="ms-auto d-flex align-items-center gap-2">
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                       href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @if (!string.IsNullOrEmpty(picPath))
                        {
                            <img src="/Employee/Profile/Avatar?fileName=@picPath"
                                 class="rounded-circle"
                                 style="width:34px;height:34px;object-fit:cover;
                                        border:2px solid rgba(255,255,255,.2)"
                                 alt="صورتي" />
                        }
                        else
                        {
                            <div class="avatar-circle bg-primary text-white">
                                <i class="ti ti-user"></i>
                            </div>
                        }
                        <span class="d-none d-md-inline fw-medium">@firstName</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                        <li>
                            <a class="dropdown-item" href="/Employee/Profile">
                                <i class="ti ti-user me-2"></i> ملفي الشخصي
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-area="" asp-controller="Account"
                                  asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="ti ti-logout me-2"></i>تسجيل الخروج
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <aside class="il-sidebar">
        <div class="p-3 text-white border-bottom border-secondary mb-3">
            <h6 class="fw-bold mb-1">بوابة الموظف</h6>
            <small class="text-white-50">@firstName</small>
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   href="/Employee/Dashboard">
                    <i class="ti ti-dashboard me-2"></i>الرئيسية
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")"
                   href="/Employee/Profile">
                    <i class="ti ti-user me-2"></i>ملفي الشخصي
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leaves" ? "active" : "")"
                   href="/Employee/Leaves">
                    <i class="ti ti-calendar-off me-2"></i>الإجازات
                    @if (pendingLeaves > 0)
                    {
                        <span class="badge bg-warning ms-auto">@pendingLeaves</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payslips" ? "active" : "")"
                   href="/Employee/Payslips">
                    <i class="ti ti-receipt me-2"></i>مسيرات الرواتب
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Certificates" ? "active" : "")"
                   href="/Employee/Certificates/SalaryCertificate">
                    <i class="ti ti-award me-2"></i>خطاب الراتب
                </a>
            </li>
        </ul>
    </aside>

    <main class="il-main">
        @if (TempData["Success"] != null)
        {
            <div class="il-toast alert alert-success d-flex align-items-center" role="alert">
                <i class="ti ti-check me-2 fs-5"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="il-toast alert alert-danger d-flex align-items-center" role="alert">
                <i class="ti ti-alert-circle me-2 fs-5"></i> @TempData["Error"]
            </div>
        }

        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/intilaqah.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
